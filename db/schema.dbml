// ============================================
// FindMyJob - Schéma de base de données (PostgreSQL)
// Mis à jour le 2026-10-09.
//
// Deux schémas Postgres :
//   - profile : données de l'utilisateur (CV, compétences, parcours, settings)
//   - search  : recherche d'emploi (sessions, candidatures, documents)
//
// App mono-utilisateur : les tables du schéma search ne portent pas
// de user_id. Le profil est récupéré directement (un seul user).
//
// Triggers `updated_at` (fonction trigger_set_updated_at(), BEFORE UPDATE) :
// users, projets, experiences, formations, skills, sessions, candidatures,
// contacts, interviews, documents, settings.
// status_history n'a pas de trigger updated_at.
// ============================================


// ****************************************************
//                 SCHÉMA : PROFILE
// Données stables de l'utilisateur (CV, parcours, config)
// ****************************************************

Table profile.users {
  id integer [pk, increment]
  nom text
  prenom text
  email text
  telephone text
  ville text
  adresse text        // rue, affichée dans l'en-tête de la lettre si la référence l'affiche
  code_postal text
  permis boolean [default: false]
  description text
  linkedin text
  github text
  portfolio text
  interets text       // centres d'intérêt, une ligne = un item
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
}

Table profile.lang {
  id integer [pk, increment]
  user_id integer [ref: > profile.users.id, not null]
  nom text
  level text
}

Table profile.formations {
  id integer [pk, increment]
  user_id integer [ref: > profile.users.id, not null]
  titre text [not null]
  ecole text
  description text    // détails (spécialité, cours, échange...), une ligne = un détail
  date_debut date
  date_fin date
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
}

Table profile.projets {
  id integer [pk, increment]
  user_id integer [ref: > profile.users.id, not null]
  titre text [not null]
  description text
  stack text          // technologies utilisées, texte libre
  url text            // repo ou démo
  pour_qui text       // client / employeur / projet perso
  date_debut date
  date_fin date
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
}

// Distinct de candidature_type : pas de "freelance" ici.
Enum experience_type_contrat {
  stage
  alternance
  interim
  cdd
  cdi
}

Table profile.experiences {
  id integer [pk, increment]
  user_id integer [ref: > profile.users.id, not null]
  poste text [not null]
  entreprise text
  lieu text
  description text
  date_debut date
  date_fin date
  type_contrat experience_type_contrat
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
}

Table profile.skills {
  id integer [pk, increment]
  user_id integer [ref: > profile.users.id, not null]
  domaine text [not null]   // "Langages", "Data & ML", "Data Engineering"...
  nom text [not null]       // "Python", "PyTorch"...
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
}

Table profile.settings {
  id integer [pk, increment]
  cle text [not null, unique]   // "llm_model", "theme"
  valeur text
  updated_at timestamp [not null, default: `now()`]
}


// ****************************************************
//                 SCHÉMA : SEARCH
// Recherche d'emploi (sessions, offres, candidatures)
// Mono-utilisateur : pas de user_id sur ces tables.
// ****************************************************

// ============================================
// Sessions
// ============================================

Enum session_statut {
  active
  pause
  termine
}

Table search.sessions {
  id integer [pk, increment]
  nom text [not null]
  statut session_statut [not null, default: 'active']
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]

  Note: 'Regroupe un ensemble de candidatures pour une recherche ciblée.\nPossède son propre CV et sa propre lettre de motivation de référence,\ntracés dans documents.'
}

// ============================================
// Candidatures (cœur)
// ============================================

Enum candidature_type {
  stage
  alternance
  cdi
  cdd
  interim
  freelance
}

Enum candidature_status {
  a_postuler
  postule
  relance
  entretien
  entretien_passe // entretien passé, en attente de retour
  offre           // statut intermédiaire : peut encore être accepté ou décliné
  refus
  abandon
  ghosting
  accepte
  offre_refusee
}

Table search.candidatures {
  id integer [pk, increment]
  session_id integer [ref: > search.sessions.id, not null]
  poste text [not null]
  type candidature_type
  status candidature_status [not null, default: 'a_postuler']
  source text                 // canal de candidature, voir SOURCE_OPTIONS côté frontend
  url_offre text
  description_offre text      // texte brut de l'annonce, entrée du pipeline IA
  entreprise text
  localisation text
  remuneration text
  notes text
  cv_path text                // chemin du CV généré/joint
  lettre_motivation_path text
  cv_reference_version_id integer [ref: > search.document_versions.id]  // ON DELETE SET NULL — version de CV de référence utilisée à la génération
  lm_reference_version_id integer [ref: > search.document_versions.id]  // ON DELETE SET NULL — version de LM de référence utilisée à la génération
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
}

// status_history est une timeline unifiée : event_type n'a pas de CHECK SQL,
// la validation vit côté Rust (EventType, crates/core/src/models/event_type.rs).
Table search.status_history {
  id integer [pk, increment]
  candidature_id integer [ref: > search.candidatures.id, not null, delete: cascade]
  event_type text [not null]           // voir EventType côté Rust, pas de CHECK SQL
  ancien_status candidature_status
  nouveau_status candidature_status    // nullable : un événement ne change pas toujours le statut
  content text                         // mail/message associé à l'événement
  interview_id integer [ref: > search.interviews.id]
  changed_at timestamp [not null, default: `now()`]
}

// ============================================
// Contacts & entretiens
// ============================================

Table search.contacts {
  id integer [pk, increment]
  candidature_id integer [ref: > search.candidatures.id, not null, delete: cascade]
  nom text
  role text         // "RH", "Manager", "Lead Tech"
  email text
  telephone text
  notes text
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
}

Enum interview_type {
  rh
  technique
  manager
  final
  autre
}

Enum interview_issue {
  en_attente
  positif
  negatif
}

Enum interview_modalite {
  visio
  presentiel
  telephone
}

Table search.interviews {
  id integer [pk, increment]
  candidature_id integer [ref: > search.candidatures.id, not null, delete: cascade]
  contact_id integer [ref: > search.contacts.id]
  type interview_type
  modalite interview_modalite
  date_entretien timestamp
  lieu text         // texte libre : adresse, lien de visio, numéro
  issue interview_issue [default: 'en_attente']
  notes text
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
}

// ============================================
// Documents (CV / LM) — fichiers sur disque
// ============================================
// Un document de référence par type et par session. Une référence n'est
// utilisable par la génération qu'une fois templatisée (template_path non
// null) : le template lit ses données depuis un JSON au schéma canonique.
// Le document rattaché
// à une candidature (généré ou joint) est tracé par candidatures.cv_path /
// lettre_motivation_path, pas par cette table.

Enum document_type {
  cv
  lettre_motivation
}

Table search.documents {
  id integer [pk, increment]
  session_id integer [ref: > search.sessions.id, not null]   // ON DELETE CASCADE
  doc_type document_type [not null]
  original_filename text [not null]
  file_path text [not null]
  pdf_path text
  template_path text      // template.typ de la version courante, null tant que non templatisée
  example_data_path text  // example_data.json de la version courante
  page_count integer      // nombre de pages du PDF de référence
  current_version_id integer [ref: > search.document_versions.id]  // ON DELETE SET NULL — version courante, null si antérieure au versioning
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]

  indexes {
    (session_id, doc_type) [unique, name: 'uq_documents_session_doctype']
  }
}

// Historique des documents de référence : une ligne par upload, jamais
// écrasée. Fichiers sous documents/sessions/<session_id>/<doc_type>/versions/<id>/.
// documents recopie la version courante (current_version_id).
Table search.document_versions {
  id integer [pk, increment]
  session_id integer [ref: > search.sessions.id, not null]   // ON DELETE CASCADE
  doc_type document_type [not null]
  version integer [not null]              // numéro d'affichage, MAX+1 par (session_id, doc_type)
  original_filename text [not null]
  typst_path text [not null]
  pdf_path text [not null]
  template_path text      // template.typ produit à l'upload (null si non templatisée)
  example_data_path text  // example_data.json produit à l'upload
  page_count integer      // nombre de pages du PDF de référence
  created_at timestamp [not null, default: `now()`]

  indexes {
    (session_id, doc_type, version) [unique, name: 'uq_document_version']
    (session_id, doc_type) [name: 'idx_document_versions_session']
  }
}
