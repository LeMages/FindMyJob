// ============================================
// FindMyJob - Schéma de base de données (SQLite)
// Mis à jour le 2026-10-20 (migrations db/migrations/sqlite/0001_init.sql à 0007_langue_profil.sql).
//
// Base locale de l'application desktop : <dossier de données>/findmyjob.db.
// Toutes les tables sont STRICT ; PRAGMA foreign_keys = ON à chaque connexion.
// App mono-utilisateur : aucune table ne porte de user_id, users n'a qu'une
// ligne (id = 1).
//
// Conventions de ce fichier (pour rester lisible dans dbdiagram) :
//   - `integer [pk, increment]` = INTEGER PRIMARY KEY (AUTOINCREMENT quand
//     l'identifiant nomme un dossier : sessions, document_versions,
//     candidatures) ;
//   - les `Enum` DBML représentent des colonnes TEXT contraintes par un CHECK ;
//   - `timestamp` = TEXT RFC 3339 UTC en millisecondes
//     ('YYYY-MM-DDTHH:MM:SS.mmmZ'), écrit par le code (aucun trigger, aucun
//     défaut) ; `date` = TEXT 'YYYY-MM-DD' ; `boolean` = INTEGER 0/1 ;
//   - les chemins de fichiers sont relatifs au dossier de données, séparateur '/'.
// ============================================


// ****************************************************
//                      PROFIL
// ****************************************************

Table users {
  id integer [pk, note: "CHECK (id = 1)"]
  nom text [not null]
  prenom text [not null]
  email text [not null]
  telephone text
  ville text          // ville du candidat ; avec zip_code, seul lieu du profil (pas d'adresse postale)
  zip_code text       // code postal du candidat
  permis boolean [note: "NULL = non renseigné"]
  description text
  linkedin text
  github text
  portfolio text
  interets text       // une ligne = un centre d'intérêt
  langue_profil text [not null, default: 'fr', note: "CHECK IN ('fr', 'en') ; langue dans laquelle le profil est rédigé"]
  created_at timestamp [not null]
}

Table experiences {
  id integer [pk, increment]
  poste text [not null]
  entreprise text
  lieu text
  description text
  date_debut date
  date_fin date
  type_contrat contract_type
  created_at timestamp [not null]
}

Table formations {
  id integer [pk, increment]
  titre text [not null]
  ecole text
  description text    // une ligne = un détail
  date_debut date
  date_fin date
  created_at timestamp [not null]
}

Table projets {
  id integer [pk, increment]
  titre text [not null]
  description text
  stack text
  url text
  pour_qui text
  date_debut date
  date_fin date
  created_at timestamp [not null]
}

Table skills {
  id integer [pk, increment]
  domaine text [not null]
  nom text [not null]
  created_at timestamp [not null]

  indexes {
    (domaine, nom) [unique]
  }
}

Table langues {
  id integer [pk, increment]
  nom text [not null, unique]
  level text
  created_at timestamp [not null]
}

Table settings {
  cle text [pk, note: "'llm_model', 'theme', 'ui_lang'"]
  valeur text
}


// ****************************************************
//               SESSIONS ET DOCUMENTS
// ****************************************************

Table sessions {
  id integer [pk, increment, note: "AUTOINCREMENT"]
  nom text [not null]
  statut session_status [not null, default: 'active']
  created_at timestamp [not null]
}

Table document_versions {
  id integer [pk, increment, note: "AUTOINCREMENT ; nomme le dossier versions/<id>/"]
  session_id integer [not null, ref: > sessions.id, note: "ON DELETE CASCADE"]
  doc_type doc_type [not null]
  version integer [not null]          // numéro d'affichage par (session, doc_type)
  original_filename text [not null]
  typst_path text [not null]
  pdf_path text [not null]
  template_path text
  example_data_path text
  page_count integer
  created_at timestamp [not null]

  indexes {
    (session_id, doc_type, version) [unique]
  }
}

// Pointeur vers la version courante de chaque référence.
Table documents {
  session_id integer [not null, ref: > sessions.id, note: "ON DELETE CASCADE"]
  doc_type doc_type [not null]
  current_version_id integer [not null, ref: > document_versions.id, note: "ON DELETE CASCADE"]
  updated_at timestamp [not null]     // dernier upload ou dernière restauration

  indexes {
    (session_id, doc_type) [pk]
  }
}


// ****************************************************
//                   CANDIDATURES
// ****************************************************

Table candidatures {
  id integer [pk, increment, note: "AUTOINCREMENT ; nomme artefact/<id>.* et debug/<id>/"]
  session_id integer [not null, ref: > sessions.id, note: "ON DELETE CASCADE"]
  poste text [not null]
  type_contrat contract_type [not null]
  status candidature_status [not null, default: 'a_postuler']
  source text [not null]
  url_offre text
  description_offre text [not null]
  entreprise text [not null]
  localisation text [not null]
  remuneration text
  notes text
  cv_path text
  lettre_motivation_path text
  cv_reference_version_id integer [ref: > document_versions.id, note: "ON DELETE SET NULL"]
  lm_reference_version_id integer [ref: > document_versions.id, note: "ON DELETE SET NULL"]
  generation_warnings text [not null, default: '[]', note: "liste JSON des avertissements de la génération (pages dépassées…)"]
  created_at timestamp [not null]

  indexes {
    session_id
  }
}

Table contacts {
  id integer [pk, increment]
  nom text [not null]
  role text
  email text
  telephone text
  notes text
  created_at timestamp [not null]

  Note: "Carnet global : un contact existe sans candidature et peut être lié à plusieurs (candidature_contacts)."
}

Table candidature_contacts {
  candidature_id integer [not null, ref: > candidatures.id, note: "ON DELETE CASCADE"]
  contact_id integer [not null, ref: > contacts.id, note: "ON DELETE CASCADE"]
  created_at timestamp [not null]

  indexes {
    (candidature_id, contact_id) [pk]
    contact_id
  }
}

Table interviews {
  id integer [pk, increment]
  candidature_id integer [not null, ref: > candidatures.id, note: "ON DELETE CASCADE"]
  type_entretien interview_type
  modalite interview_mode
  date_entretien timestamp
  lieu text
  issue interview_outcome [not null, default: 'en_attente']
  notes text
  created_at timestamp [not null]

  indexes {
    candidature_id
  }
}

Table interview_contacts {
  interview_id integer [not null, ref: > interviews.id, note: "ON DELETE CASCADE"]
  contact_id integer [not null, ref: > contacts.id, note: "ON DELETE CASCADE"]

  indexes {
    (interview_id, contact_id) [pk]
  }
}

Table status_history {
  id integer [pk, increment]
  candidature_id integer [not null, ref: > candidatures.id, note: "ON DELETE CASCADE"]
  event_type event_type [not null]
  ancien_status candidature_status
  nouveau_status candidature_status
  content text
  interview_id integer [ref: > interviews.id, note: "ON DELETE SET NULL"]
  changed_at timestamp [not null]

  indexes {
    candidature_id
  }
}


// ****************************************************
//            VALEURS CONTRAINTES (CHECK)
// ****************************************************

Enum contract_type {
  stage
  alternance
  cdi
  cdd
  interim
  freelance
}

Enum session_status {
  active
  pause
  termine
}

Enum doc_type {
  cv
  lettre_motivation
}

Enum candidature_status {
  a_postuler
  postule
  relance
  entretien
  entretien_passe
  offre
  refus
  abandon
  ghosting
  accepte
  offre_refusee
}

Enum interview_type {
  rh
  technique
  manager
  final
  autre
}

Enum interview_mode {
  visio
  presentiel
  telephone
}

Enum interview_outcome {
  en_attente
  positif
  negatif
}

Enum event_type {
  creation
  candidature_envoyee
  relance
  entretien_planifie
  entretien_passe
  offre_recue
  refus_recu
  ghosting
  desistement
  accepter_offre
  decliner_offre
  message_envoye
  message_recu
  appel
  note
}
