// ============================================
// FindMyJob - Schéma de base de données (SQLite)
// Généré à partir de db/migrations/0001 à 0015.
// ============================================

Table users {
  id integer [pk, increment]
  nom varchar
  prenom varchar
  email varchar
  telephone varchar
  ville varchar
  permis boolean
  description text
  linkedin varchar
  github varchar
  portfolio varchar
  created_at timestamp
  updated_at timestamp
}

Table lang {
  id integer [pk, increment]
  user_id integer [ref: > users.id, not null]
  nom text
  level text
}

// ============================================
// Profil : formations, projets, expériences, skills
// ============================================

Table formations {
  id integer [pk, increment]
  user_id integer [ref: > users.id, not null]
  titre varchar [not null]
  ecole varchar
  date_debut date
  date_fin date
  created_at timestamp
  updated_at timestamp
}

Table projets {
  id integer [pk, increment]
  user_id integer [ref: > users.id, not null]
  titre varchar [not null]
  description text
  stack text          // technologies utilisées, texte libre
  url varchar         // repo ou démo
  pour_qui text        // client / employeur / projet perso (migration 0004)
  date_debut date
  date_fin date
  created_at timestamp
  updated_at timestamp
}

Table experiences {
  id integer [pk, increment]
  user_id integer [ref: > users.id, not null]
  poste varchar [not null]
  entreprise varchar
  lieu varchar
  description text
  date_debut date
  date_fin date
  type_contrat experience_type_contrat  // migration 0002
  created_at timestamp
  updated_at timestamp
}

Table skills {
  id integer [pk, increment]
  user_id integer [ref: > users.id, not null]
  domaine varchar [not null]   // "Langages", "Data & ML", "Data Engineering"...
  nom varchar [not null]       // "Python", "PyTorch"...
  created_at timestamp
  updated_at timestamp
}

// ============================================
// Sessions de candidature
// ============================================

Table sessions {
  id integer [pk, increment]
  user_id integer [ref: > users.id, not null]
  nom varchar [not null]
  contexte text            // migration 0010
  statut session_statut [not null, default: 'active']  // migration 0010
  zone varchar              // migration 0010
  created_at timestamp
  updated_at timestamp

  Note: 'Regroupe un ensemble de candidatures. Possède son propre CV et sa\npropre lettre de motivation de référence, tracés dans documents\n(session.cv_path / lm_path ont été droppées en 0012, remplacées par la table documents en 0011).'
}

// ============================================
// Candidatures (cœur)
// ============================================

Enum candidature_type {
  stage
  alternance
  cdi
  cdd
  interim   // ajouté en migration 0005
  freelance
}

// Recréée en 0005 (ajout interim), 0014 (ajout ghosting), 0015 (ajout
// accepte / offre_refusee) : SQLite ne permet pas d'altérer un CHECK.
Enum candidature_status {
  a_postuler
  postule
  relance
  entretien
  offre           // statut intermédiaire depuis 0015 : peut encore être accepté ou décliné
  refus
  abandon
  ghosting        // migration 0014
  accepte         // migration 0015
  offre_refusee   // migration 0015
}

Table candidatures {
  id integer [pk, increment]
  user_id integer [ref: > users.id, not null]
  session_id integer [ref: > sessions.id]        // migration 0008
  poste varchar [not null]
  type candidature_type
  status candidature_status [not null, default: 'a_postuler']
  source varchar              // canal de candidature, voir SOURCE_OPTIONS côté frontend
  url_offre varchar
  description_offre text      // texte brut de l'annonce, entrée du pipeline IA
  entreprise text
  localisation varchar
  remuneration varchar
  date_candidature date       // colonne présente mais jamais écrite par le code actuel
  next_relance date           // colonne présente mais jamais écrite par le code actuel
  last_relance date           // colonne présente mais jamais écrite par le code actuel
  notes text
  cv_path text                    // migration 0009 : chemin du CV généré/joint, remplace documents.candidature_id
  lettre_motivation_path text     // migration 0009
  created_at timestamp
  updated_at timestamp
}

// status_history est devenue une timeline unifiée en migration 0014 :
// event_type n'a pas de CHECK SQL, la validation vit côté Rust
// (EventType, src-tauri/src/models/event_type.rs) — 15 valeurs possibles :
// creation, candidature_envoyee, relance, entretien_planifie,
// entretien_passe, offre_recue, refus_recu, ghosting, desistement,
// accepter_offre, decliner_offre, message_envoye, message_recu, appel, note.
Table status_history {
  id integer [pk, increment]
  candidature_id integer [ref: > candidatures.id, not null]
  event_type varchar [not null]        // voir EventType côté Rust, pas de CHECK SQL
  ancien_status candidature_status
  nouveau_status candidature_status    // nullable depuis 0014 : un événement ne change pas toujours le statut
  content text                         // migration 0013 : mail/message associé à l'événement
  interview_id integer [ref: > interviews.id]  // migration 0014
  changed_at timestamp
}

// ============================================
// Contacts & entretiens
// ============================================

Table contacts {
  id integer [pk, increment]
  candidature_id integer [ref: > candidatures.id, not null]
  nom varchar
  role varchar         // "RH", "Manager", "Lead Tech"
  email varchar
  telephone varchar
  notes text
  created_at timestamp
  updated_at timestamp
}

Enum interview_type {
  rh
  technique
  manager
  final
  autre
}

Enum interview_issue {
  en_attente
  positif
  negatif
}

Table interviews {
  id integer [pk, increment]
  candidature_id integer [ref: > candidatures.id, not null]
  type interview_type
  date_entretien timestamp
  lieu varchar         // visio, sur site, téléphone
  issue interview_issue [default: 'en_attente']
  notes text
  contact_id integer [ref: > contacts.id]  // migration 0014 : contact rencontré
  created_at timestamp
  updated_at timestamp
}

// ============================================
// Documents (CV / LM) — fichiers sur disque
// ============================================
// Table refondue en 0009 (suppression de l'ancienne table documents liée aux
// candidatures) puis recréée en 0011 avec un rôle différent : un document
// de référence par type et par session, contenu sur le filesystem, métadonnées
// et cache d'analyse de style en base. Le document rattaché à une candidature
// (généré ou joint) est tracé par candidatures.cv_path / lettre_motivation_path,
// pas par cette table.

Enum document_type {
  cv
  lettre_motivation
}

Table documents {
  id integer [pk, increment]
  session_id integer [ref: > sessions.id, not null]
  doc_type document_type [not null]
  original_filename varchar [not null]
  file_path varchar [not null]
  pdf_path varchar
  style_analysis text   // cache JSON de l'analyse de style LLM, calculé à la sauvegarde de la référence
  created_at timestamp
  updated_at timestamp

  indexes {
    (session_id, doc_type) [unique]
  }
}

// ============================================
// Emails envoyés depuis l'app
// ============================================

Enum email_type {
  candidature
  relance
  remerciement
  reponse
  autre
}

Table emails {
  id integer [pk, increment]
  candidature_id integer [ref: > candidatures.id, not null]
  contact_id integer [ref: > contacts.id]
  type email_type
  sujet varchar
  corps text
  destinataire varchar
  sent_at timestamp
  created_at timestamp

  Note: 'email_attachments a été supprimée en migration 0009 : plus de table de\ndocuments partagée à joindre à un email.'
}

// ============================================
// Profil : type de contrat des expériences
// ============================================
// Distinct de candidature_type : ordre et valeurs légèrement différents
// (pas de "freelance" ici), ajouté en migration 0002.
Enum experience_type_contrat {
  stage
  alternance
  interim
  cdd
  cdi
}

Enum session_statut {
  active
  pause
  termine
}

// ============================================
// Embeddings (matching) — table polymorphe, non utilisée par le code actuel
// ============================================
// Prévue pour un matching par similarité vectorielle (modèle bge-m3,
// cosinus en brute-force). Le matching profil ↔ offre passe aujourd'hui par
// un appel LLM (src-tauri/src/llm/matching.rs), pas par cette table.

Table embeddings {
  id integer [pk, increment]
  entity_type varchar [not null]   // "projet", "experience", "candidature"
  entity_id integer [not null]     // FK logique (pas de contrainte stricte)
  model varchar [not null]         // "bge-m3"
  dimensions integer
  vector blob [not null]           // vecteur sérialisé
  created_at timestamp

  indexes {
    (entity_type, entity_id)
  }
}

// ============================================
// Paramètres de l'app (clé-valeur) — non utilisée par le code actuel
// ============================================
// Page Settings encore en maquette front (aucune commande Tauri branchée) :
// cette table n'est ni écrite ni lue aujourd'hui.

Table settings {
  id integer [pk, increment]
  cle varchar [not null, unique]   // "ia_mode", "ia_model", "theme"...
  valeur varchar
  updated_at timestamp
}
