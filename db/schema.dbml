// ============================================
// FindMyJob - Schéma de base de données (PostgreSQL)
// Mis à jour le 2026-09-18.
//
// Deux schémas Postgres :
//   - profile : données de l'utilisateur (CV, compétences, parcours, settings)
//   - search  : recherche d'emploi (sessions, candidatures, offres)
//
// App mono-utilisateur : les tables du schéma search ne portent pas
// de user_id. Le profil est récupéré directement (un seul user).
//
// Triggers `updated_at` (fonction trigger_set_updated_at(), BEFORE UPDATE) :
// users, projets, experiences, formations, skills, sessions, candidatures,
// contacts, interviews, documents, settings.
// offers et status_history n'ont pas de trigger updated_at.
// ============================================


// ****************************************************
//                 SCHÉMA : PROFILE
// Données stables de l'utilisateur (CV, parcours, config)
// ****************************************************

Table profile.users {
  id integer [pk, increment]
  nom text
  prenom text
  email text
  telephone text
  ville text
  permis boolean [default: false]
  description text
  linkedin text
  github text
  portfolio text
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
}

Table profile.lang {
  id integer [pk, increment]
  user_id integer [ref: > profile.users.id, not null]
  nom text
  level text
}

Table profile.formations {
  id integer [pk, increment]
  user_id integer [ref: > profile.users.id, not null]
  titre text [not null]
  ecole text
  date_debut date
  date_fin date
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
}

Table profile.projets {
  id integer [pk, increment]
  user_id integer [ref: > profile.users.id, not null]
  titre text [not null]
  description text
  stack text          // technologies utilisées, texte libre
  url text            // repo ou démo
  pour_qui text       // client / employeur / projet perso
  date_debut date
  date_fin date
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
}

// Distinct de candidature_type : pas de "freelance" ici.
Enum experience_type_contrat {
  stage
  alternance
  interim
  cdd
  cdi
}

Table profile.experiences {
  id integer [pk, increment]
  user_id integer [ref: > profile.users.id, not null]
  poste text [not null]
  entreprise text
  lieu text
  description text
  date_debut date
  date_fin date
  type_contrat experience_type_contrat
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
}

Table profile.skills {
  id integer [pk, increment]
  user_id integer [ref: > profile.users.id, not null]
  domaine text [not null]   // "Langages", "Data & ML", "Data Engineering"...
  nom text [not null]       // "Python", "PyTorch"...
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
}

Table profile.settings {
  id integer [pk, increment]
  cle text [not null, unique]   // "llm_model", "theme"
  valeur text
  updated_at timestamp [not null, default: `now()`]
}


// ****************************************************
//                 SCHÉMA : SEARCH
// Recherche d'emploi (sessions, offres, candidatures)
// Mono-utilisateur : pas de user_id sur ces tables.
// ****************************************************

// ============================================
// Sessions
// ============================================

Enum session_statut {
  active
  pause
  termine
}

Table search.sessions {
  id integer [pk, increment]
  nom text [not null]
  contexte text
  statut session_statut [not null, default: 'active']
  zone text
  min_score real [not null, default: 0.5, note: 'Seuil d affichage des offres (Marché), CHECK entre 0.05 et 1']
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]

  Note: 'Regroupe un ensemble de candidatures et d offres pour une recherche\nciblée (zone géographique, type de poste). Possède son propre CV et sa\npropre lettre de motivation de référence, tracés dans documents.'
}

// ============================================
// Requêtes de recherche d'une session — pilotent le scraping (remplace la
// config statique [[searches]] d'agent.toml)
// ============================================

Table search.search_queries {
  id integer [pk, increment]
  session_id integer [ref: > search.sessions.id, not null]
  keywords text [not null]
  location text
  country_code text
  created_at timestamp [not null, default: `now()`]

  indexes {
    session_id [name: 'idx_search_queries_session_id']
  }
}

// ============================================
// Offres scrapées — liées à une session
// ============================================

Table search.offers {
  id integer [pk, increment]
  session_id integer [ref: > search.sessions.id, not null]
  source varchar [not null]           // plateforme d'origine (WTTJ, LinkedIn...)
  source_id varchar                   // identifiant chez la plateforme source
  title text [not null]
  company text [not null]
  location text [not null]
  url text [not null, unique]         // uq_offers_url
  contract_type varchar
  posted_at timestamp
  scraped_at timestamp [not null, default: `now()`]
  status varchar [not null, default: 'new']
  score real                          // score de pertinence calculé par le pipeline
  description text
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]

  indexes {
    status [name: 'idx_offers_status']
    source [name: 'idx_offers_source']
    posted_at [name: 'idx_offers_posted_at']
    session_id [name: 'idx_offers_session_id']
  }
}

// ============================================
// Candidatures (cœur)
// ============================================

Enum candidature_type {
  stage
  alternance
  cdi
  cdd
  interim
  freelance
}

Enum candidature_status {
  a_postuler
  postule
  relance
  entretien
  entretien_passe // entretien passé, en attente de retour
  offre           // statut intermédiaire : peut encore être accepté ou décliné
  refus
  abandon
  ghosting
  accepte
  offre_refusee
}

Table search.candidatures {
  id integer [pk, increment]
  session_id integer [ref: > search.sessions.id, not null]
  offer_id integer [ref: > search.offers.id]  // offre source si créée depuis le Marché, null si saisie manuelle
  poste text [not null]
  type candidature_type
  status candidature_status [not null, default: 'a_postuler']
  source text                 // canal de candidature, voir SOURCE_OPTIONS côté frontend
  url_offre text
  description_offre text      // texte brut de l'annonce, entrée du pipeline IA
  entreprise text
  localisation text
  remuneration text
  notes text
  cv_path text                // chemin du CV généré/joint
  lettre_motivation_path text
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
}

// status_history est une timeline unifiée : event_type n'a pas de CHECK SQL,
// la validation vit côté Rust (EventType, crates/core/src/models/event_type.rs).
Table search.status_history {
  id integer [pk, increment]
  candidature_id integer [ref: > search.candidatures.id, not null]
  event_type text [not null]           // voir EventType côté Rust, pas de CHECK SQL
  ancien_status candidature_status
  nouveau_status candidature_status    // nullable : un événement ne change pas toujours le statut
  content text                         // mail/message associé à l'événement
  interview_id integer [ref: > search.interviews.id]
  changed_at timestamp [not null, default: `now()`]
}

// ============================================
// Contacts & entretiens
// ============================================

Table search.contacts {
  id integer [pk, increment]
  candidature_id integer [ref: > search.candidatures.id, not null]
  nom text
  role text         // "RH", "Manager", "Lead Tech"
  email text
  telephone text
  notes text
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
}

Enum interview_type {
  rh
  technique
  manager
  final
  autre
}

Enum interview_issue {
  en_attente
  positif
  negatif
}

Enum interview_modalite {
  visio
  presentiel
  telephone
}

Table search.interviews {
  id integer [pk, increment]
  candidature_id integer [ref: > search.candidatures.id, not null]
  contact_id integer [ref: > search.contacts.id]
  type interview_type
  modalite interview_modalite
  date_entretien timestamp
  lieu text         // texte libre : adresse, lien de visio, numéro
  issue interview_issue [default: 'en_attente']
  notes text
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
}

// ============================================
// Documents (CV / LM) — fichiers sur disque
// ============================================
// Un document de référence par type et par session. Le document rattaché
// à une candidature (généré ou joint) est tracé par candidatures.cv_path /
// lettre_motivation_path, pas par cette table.

Enum document_type {
  cv
  lettre_motivation
}

Table search.documents {
  id integer [pk, increment]
  session_id integer [ref: > search.sessions.id, not null]   // ON DELETE CASCADE
  doc_type document_type [not null]
  original_filename text [not null]
  file_path text [not null]
  pdf_path text
  style_analysis text   // cache de l'analyse de style LLM
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]

  indexes {
    (session_id, doc_type) [unique, name: 'uq_documents_session_doctype']
  }
}
