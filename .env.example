# Copy this file to .env and fill in the value.
#
# Where the app looks for .env, in order:
#   1. the app config directory (installed app), e.g. %APPDATA%\com.findmyjob.app\.env on Windows;
#   2. the current directory and its parents (development: repository root).

# Anthropic API key, used in DEV mode only. In PROD the app ignores it: the key is entered
# in Paramètres and stored in the system keyring (Windows Credential Manager, macOS Keychain,
# Linux Secret Service).
ANTHROPIC_API_KEY=

# Run mode: DEV stores everything in dev-data/ next to this file; PROD (default, also when absent) uses the system app folders.
MODE=PROD
